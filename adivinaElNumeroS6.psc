Algoritmo adivinaElNumero
	// un inicio y un final
	// pedir un numero y definir otro para que se puedan comparar
	
	Definir intento, seleccion Como Entero
	seleccion = 10
	Escribir  " dime un numero de 0 a " , 10
	Leer intento
	
	// una expresion logica
	// verdadero o falso
	
	// ==
	// <>
	
	Mientras seleccion <> intento Hacer
		Escribir  " dime un numero de 0 a " , 10
		Leer intento
		FinMientras
	Escribir " Felicidades ganaste"
	FinAlgoritmo